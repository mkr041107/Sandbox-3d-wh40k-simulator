# Copy this file to `.env` for local dev or self-hosted builds.
# `.env` is gitignored — never commit real API keys.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# If you run `npm run build`, these values are embedded in the JS output.
# Only use this on a server you control; do not bake secrets into public GitHub Pages builds.

# Enable LLM opponent by default (true / false)
VITE_LLM_ENABLED=true

# Provider preset: openai | openrouter | groq | custom
VITE_LLM_PROVIDER=custom

# Your API key (required for LLM mode)
VITE_LLM_API_KEY=

# Required for custom/third-party APIs — set provider to custom
# VITE_LLM_BASE_URL=https://nano-gpt.com/api/v1
# VITE_LLM_MODEL=deepseek/deepseek-v4-flash

# OpenAI example:
# VITE_LLM_PROVIDER=openai
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_MODEL=gpt-4o-mini
